rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEventAdmin(eventId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.adminId;
    }

    match /events/{eventId} {
      // Gosti otvaraju pozivnicu bez logina — pojedinačno čitanje je javno
      allow get: if true;
      // Listanje evenata samo za vlasnika (dashboard upit: where adminId == uid)
      allow list: if request.auth != null && resource.data.adminId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.adminId == request.auth.uid;

      match /guests/{guestId} {
        // Gost čita svoj RSVP preko ID-a sačuvanog u svom browseru
        allow get: if true;
        // RSVP se šalje bez logina
        allow create: if true;
        // Lista svih gostiju, izmjene i brisanje — samo admin
        allow list, update, delete: if isEventAdmin(eventId);
      }

      match /photos/{photoId} {
        allow read: if true;
        allow create: if true;
        // Gosti brišu svoje slike bez logina (v1 — nema guest auth)
        allow delete: if true;
        allow update: if false;
      }

      match /tables/{tableId} {
        // Gosti vide raspored sjedenja (tab "Moj stol")
        allow read: if true;
        allow write: if isEventAdmin(eventId);
      }
    }
  }
}
