rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vlasnik servisa — dokument owners/{uid} se dodaje ručno u Firebase
    // konzoli (vidi SETUP.md). Jedini smije kreirati evente.
    function isServiceOwner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    // Eventom upravljaju klijent (adminId) i vlasnik servisa koji ga je
    // kreirao (ownerId)
    function canManageEvent(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      return request.auth != null &&
        (request.auth.uid == ev.adminId || request.auth.uid == ev.ownerId);
    }

    match /owners/{uid} {
      // Korisnik provjerava samo svoj vlasnički status (AuthContext)
      allow get: if request.auth != null && request.auth.uid == uid;
      // Vlasnici se dodaju isključivo kroz Firebase konzolu
      allow list, create, update, delete: if false;
    }

    match /events/{eventId} {
      // Gosti otvaraju pozivnicu bez logina — pojedinačno čitanje je javno
      allow get: if true;
      // Dashboard upiti: where adminId == uid (klijent) ili where ownerId == uid (vlasnik)
      allow list: if request.auth != null &&
        (resource.data.adminId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      // Evente kreira samo vlasnik servisa, sa svojim uid-om kao ownerId
      allow create: if isServiceOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.adminId == request.auth.uid || resource.data.ownerId == request.auth.uid);

      match /guests/{guestId} {
        // Gost čita svoj RSVP preko ID-a sačuvanog u svom browseru
        allow get: if true;
        // RSVP se šalje bez logina
        allow create: if true;
        // Lista svih gostiju, izmjene i brisanje — klijent i vlasnik
        allow list, update, delete: if canManageEvent(eventId);
      }

      match /photos/{photoId} {
        allow read: if true;
        allow create: if true;
        // Gosti brišu svoje slike bez logina (v1 — nema guest auth)
        allow delete: if true;
        allow update: if false;
      }

      match /tables/{tableId} {
        // Gosti vide raspored sjedenja (tab "Moj stol")
        allow read: if true;
        allow write: if canManageEvent(eventId);
      }
    }
  }
}
